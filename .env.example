# ── 店家設定：兩種寫法擇一（細節見 tenancy.py 開頭）────────────────
#
# 【單店】一個服務只有一家店（demo、本機開發）。用這個檔案下面的寫法：
#   VARIANT 加上沒前綴的 DATABASE_URL、GOOGLE_CLIENT_ID、ALLOWED_ORIGINS、
#   JOB_TOKEN、LINE_CHANNEL_SECRET、LINE_CHANNEL_ACCESS_TOKEN。
#
# 【多店家】一個服務服務好幾家店（共用的正式服務）。不要設 VARIANT，改成：
#
#   TENANTS=eli,tutor-arthur
#   ELI__DATABASE_URL=...
#   ELI__GOOGLE_CLIENT_ID=...
#   ELI__ALLOWED_ORIGINS=https://eli.boo-king-king.workers.dev
#   ELI__JOB_TOKEN=...
#   ELI__LINE_CHANNEL_SECRET=...            （有開 LINE 才要）
#   ELI__LINE_CHANNEL_ACCESS_TOKEN=...      （有開 LINE 才要）
#   TUTOR_ARTHUR__DATABASE_URL=...
#   ...（每家店一組，前綴＝店家識別轉大寫、連字號換底線、後面兩個底線）
#
#   ★ 多店家時 ALLOWED_ORIGINS 每家都必填；沒前綴的那幾個一個都不能留。
#     寫錯、拼錯鍵名、漏把店家加進 TENANTS，服務都會起不來並說是哪一個。
#   ★ BREVO_API_KEY 與下面那些「有預設值」的設定不分店，照舊寫一份就好。

# 這個部署是哪一家店（例如 tutor-arthur-demo）。單店寫法必填。
#
# 它決定後端接受哪一個網址前綴：/v/<VARIANT>/api/...
# 前端 index.html 的 __BOO_KING_KING_VARIANT__ 要填一樣的值，對不上會收到
# 404「找不到這家店」。
#
# ★ 不給預設值是刻意的。給了的話，新店家忘記設定就會安靜地接受別家店的
#   前綴、拒絕自己的——那種只有某些情境才壞的問題，上線前測不出來。
VARIANT=

# Neon 連線字串（Singapore / ap-southeast-1，與後端同區）。
# 本機開發請在 .env 填入真實值，.env 不進 git。
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Google OAuth 用戶端 ID。到 Google Cloud Console 建立 OAuth 2.0 Client ID，
# 類型選「網頁應用程式」，把前端網址加進「已授權的 JavaScript 來源」。
# 沒有這個值的話 /auth/login 一律回 401（見 auth_utils/google_auth.py）。
GOOGLE_CLIENT_ID=

# session 閒置多久才失效（天）。滑動窗口：每次請求都重新計時。
SESSION_IDLE_DAYS=90

# 權限查詢的快取秒數。停用帳號後最慢這麼久生效。
AUTH_CACHE_TTL_SECONDS=30
# 每日排程與 /internal/idle-gap-stats 的通行證。自己產一組長亂數
# （例如 python -c "import secrets;print(secrets.token_hex(32))"）。
# 沒設定的話那兩支端點一律回 503，預設是關著的。
JOB_TOKEN=

# 允許呼叫這個後端的前端來源，逗號分隔，含 scheme、不要結尾斜線。
# 例如 https://booking.example.com,https://boo-king-king.pages.dev
# ★ 正式環境必填。留空會放行任何來源，並在啟動時印警告。
ALLOWED_ORIGINS=

# Brevo 寄通知信用。沒設就整個通知功能靜默停用，其他功能不受影響。
# 取得：Brevo → SMTP & API → API Keys。正式環境設在 Render 的 Environment。
BREVO_API_KEY=

# ── 以下都有預設值，不設也能跑；列出來是為了「讀得到的設定要查得到」 ──

# Brevo 單次呼叫的逾時秒數（預設 10）。
BREVO_TIMEOUT_SECONDS=
# 待寄信件的佇列上限，滿了就丟掉最新的那封（預設 200）。
NOTIFY_QUEUE_MAX=
# settings 與 notification_template 的快取秒數（預設 600）。
NOTIFY_CACHE_TTL_SECONDS=
# roles 表的快取秒數（預設 600）。
ROLE_CACHE_TTL_SECONDS=
# session 解析結果的快取秒數（預設 3）。設太長會延後「停權立即生效」。
SESSION_CACHE_TTL_SECONDS=
# 可預約時段的快取秒數（預設 3）。
SLOT_CACHE_TTL_SECONDS=
# functions 表（每家店開了哪些功能）的快取秒數（預設 600）。
FUNCTION_CACHE_TTL_SECONDS=
# 整台機器同時最多幾條資料庫連線（預設 5）。保護的是 Render 那台機器：
# 免費方案 0.1 CPU，升級成付費機器之後可以實測再調高。見 db/connection.py。
DB_MAX_CONCURRENT=
# 每一家店同時最多幾條（預設：只有一家店時等於上面那個；好幾家時是 3）。
# 防的是一家店開賣搶位時把整台機器的名額用光，其他店連登入都卡住。
DB_MAX_CONCURRENT_PER_TENANT=
# 公開簡介頁（/mmg/<id>）每個 IP 每分鐘最多幾次（預設 30）；封面圖另計（預設 120）。
# 10 分鐘內被擋 3 次的 IP 會封鎖 10 分鐘。見 intro_public.py。
INTRO_RATE_PER_MINUTE=
INTRO_COVER_RATE_PER_MINUTE=
# 簡介頁內容在記憶體裡快取幾秒（預設 60）。店家改了簡介會立刻作廢，這個只影響
# 上下架時間到點之類「沒有人按儲存」的變化最慢多久反映。
INTRO_CACHE_TTL_SECONDS=

# ── LINE bot（群組裡 tag 一下就訂場）──────────────────────────
#
# 兩個都設才會啟用，缺任一個整包停用（路由回 503）——同 BREVO_API_KEY
# 的理由：憑證不是行為，不放進 functions 表。不用 LINE 的店不設就好。
#
# 取得：LINE Developers Console → 你的 Messaging API channel
#   Channel secret       在「Basic settings」分頁
#   Channel access token 在「Messaging API」分頁最下面，按 Issue
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=

# 呼叫 LINE API 的逾時秒數（預設 5）。
LINE_TIMEOUT_SECONDS=
# 推播佇列上限，滿了丟掉最新的（預設 100）。
LINE_QUEUE_MAX=
# line_template 的快取秒數（預設 600）。
LINE_TEMPLATE_CACHE_TTL_SECONDS=
