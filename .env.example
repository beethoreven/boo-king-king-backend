# Neon 連線字串（Singapore / ap-southeast-1，與後端同區）。
# 本機開發請在 .env 填入真實值，.env 不進 git。
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Google OAuth 用戶端 ID。到 Google Cloud Console 建立 OAuth 2.0 Client ID，
# 類型選「網頁應用程式」，把前端網址加進「已授權的 JavaScript 來源」。
# 沒有這個值的話 /auth/login 一律回 401（見 auth_utils/google_auth.py）。
GOOGLE_CLIENT_ID=

# session 閒置多久才失效（天）。滑動窗口：每次請求都重新計時。
SESSION_IDLE_DAYS=90

# 權限查詢的快取秒數。停用帳號後最慢這麼久生效。
AUTH_CACHE_TTL_SECONDS=30
# 每日排程與 /internal/idle-gap-stats 的通行證。自己產一組長亂數
# （例如 python -c "import secrets;print(secrets.token_hex(32))"）。
# 沒設定的話那兩支端點一律回 503，預設是關著的。
JOB_TOKEN=

# 允許呼叫這個後端的前端來源，逗號分隔，含 scheme、不要結尾斜線。
# 例如 https://booking.example.com,https://booking-king.pages.dev
# ★ 正式環境必填。留空會放行任何來源，並在啟動時印警告。
ALLOWED_ORIGINS=
